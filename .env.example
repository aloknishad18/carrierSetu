# ====================================================
# CAREERSETU (SIH26044) - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure real credentials
# ====================================================

# Express Server Port
PORT=3001

# Cryptographic Session & OTP Salt Secret
AUTH_SECRET=careersetu_sih26044_production_secret_key_change_in_prod

# Persistent Database File / URL
DATABASE_URL=file:./server/data/db.json

# Transactional Email Service (Resend / Brevo / SendGrid / Nodemailer SMTP / Gmail)
EMAIL_FROM="CareerSetu Security <noreply@careersetu.in>"
EMAIL_API_KEY=your_transactional_email_api_key_here

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_user@gmail.com
SMTP_PASS=your_gmail_app_password

# Official Google OAuth 2.0 Sign-In Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
